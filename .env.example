# Spring Boot Hotel API
HOTEL_API_BASE_URL=https://travelonedev-services.thomascook.in/hotels-search
HOTEL_API_MODULE_ID=Traversia
HOTEL_API_USERNAME=traversia
HOTEL_API_PASSWORD=Traversia@123

# Redis
REDIS_URL=redis://localhost:6379

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=traversia
MYSQL_USER=traversia
MYSQL_PASSWORD=traversia_local

# OpenAI
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o

# Polling Configuration
POLL_TIMEOUT_SECONDS=60
POLL_INTERVAL_SECONDS=2

# Mock Provider (set to true for local/offline development without real APIs)
# When USE_MOCK_PROVIDER=true:
#   - All hotel/room API calls are served from mock JSON files in ai-service/mock-data/
#   - Redis session checks are tolerated (missing keys auto-filled with placeholders)
#   - Token fetching is skipped
#   - Hotel/room IDs are resolved via regex patterns (e.g. MOCK-HOTEL-DELHI-007 -> Delhi data)
# When USE_MOCK_PROVIDER=false:
#   - Real Spring Boot APIs are called (HOTEL_API_BASE_URL must be reachable)
#   - Redis must contain session data from a prior search (strict session validation)
#   - Bearer token is fetched and refreshed automatically
USE_MOCK_PROVIDER=false

# Mock scenario (only applies when USE_MOCK_PROVIDER=true)
#   success          - normal happy-path: autosuggest -> search -> 3 poll batches -> hotel/room details
#   empty            - autosuggest returns no results (shows EmptyState on search page)
#   timeout          - polling never completes (triggers 60s timeout -> error state)
#   downstream_error - hotel_search raises DOWNSTREAM_ERROR (shows ErrorState on search page)
MOCK_SCENARIO=success

# Fake AI / Regex mode (only applies when USE_MOCK_PROVIDER=true)
# When true, NLP intent extraction uses regex instead of OpenAI SDK (no API key needed)
# Supports destinations: Goa, Mumbai, New Delhi, Dubai, Bangkok
# Supports guest counts ("2 adults", "1 child"), room counts, and date formats (20 Oct, 5 Nov)
USE_FAKE_AI=false
